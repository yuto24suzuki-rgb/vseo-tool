# Anthropic (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Ads API (Keyword Planner)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_oauth2_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_oauth2_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# vidIQ MCP Server（任意 — 未設定の場合はvidIQ連携をスキップ）
# APIキーは vidIQ アカウント（https://vidiq.com/mcp/）から発行
VIDIQ_API_KEY=your_vidiq_api_key_here
# VIDIQ_MCP_URL=https://mcp.vidiq.com/mcp

# Backend server
PORT=3001
FRONTEND_URL=http://localhost:3000
